    "setup": "node src/cli.ts setup",
    "publish": "node src/cli.ts publish",
    "verify": "node src/cli.ts verify",
    "ship": "node src/cli.ts ship",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
